pipeline {
    agent any

    parameters {
        string(name: 'VERSION', defaultValue: '', description: 'Enter a custom version tag (leave empty to use BUILD_NUMBER)')
    }

    environment {
        DOCKER_HUB_REPO = 'amoghkrrish/flask-jenkins-cicd'
    }

    stages {
        stage('Set Version Tag') {
            steps {
                script {
                    if (params.VERSION) {
                        env.DOCKER_TAG = "v${params.VERSION}"
                    } else {
                        env.DOCKER_TAG = "v${BUILD_NUMBER}"
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image ${DOCKER_HUB_REPO}:${env.DOCKER_TAG}..."
                dir('day4-parametrized') {   // still using the existing app folder
                    sh "docker build -t ${DOCKER_HUB_REPO}:${env.DOCKER_TAG} ."
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                echo "Pushing image ${DOCKER_HUB_REPO}:${env.DOCKER_TAG} to Docker Hub..."
                dir('day4-parametrized') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh '''
                            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                            docker push ${DOCKER_HUB_REPO}:${DOCKER_TAG}
                            docker logout
                        '''
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo "Deploying ${DOCKER_HUB_REPO}:${env.DOCKER_TAG} to Kubernetes..."
                dir('day5-terraform') {   // the YAML file is here now
                    withCredentials([string(credentialsId: 'k8s-token', variable: 'K8S_TOKEN')]) {
                        sh """
                            kubectl --server=https://minikube:8443 \\
                                    --token=${K8S_TOKEN} \\
                                    --insecure-skip-tls-verify \\
                                    apply -f k8s-flask.yaml
                            kubectl --server=https://minikube:8443 \\
                                    --token=${K8S_TOKEN} \\
                                    --insecure-skip-tls-verify \\
                                    set image deployment/flask-app flask=${DOCKER_HUB_REPO}:${env.DOCKER_TAG}
                        """
                   }
                }
            }
        }
                stage('Terraform Apply') {
            steps {
                echo "Running Terraform to ensure infrastructure..."
                dir('day5-terraform') {
                    sh '''
                        # Download main.tf and copy it to the shared host folder (mounted from host)
                        curl -fsSL -o main.tf https://raw.githubusercontent.com/amoghkrrish/jenkins-pipeline/main/day5-terraform/main.tf
                        cp main.tf /shared-host-terraform/
                    '''
                    withCredentials([string(credentialsId: 'k8s-token', variable: 'TF_VAR_k8s_token')]) {
                        sh '''
                            docker run --rm -v /Users/amoghk/jenkins-terraform:/workspace -w /workspace hashicorp/terraform:latest init
                            docker run --rm -v /Users/amoghk/jenkins-terraform:/workspace -w /workspace -e TF_VAR_k8s_token hashicorp/terraform:latest plan -out=tfplan
                            docker run --rm -v /Users/amoghk/jenkins-terraform:/workspace -w /workspace -e TF_VAR_k8s_token hashicorp/terraform:latest apply -auto-approve tfplan
                        '''
                    }
                }
            }
        }
       stage('Git Tag') {
            steps {
                echo "Tagging Git commit with ${env.DOCKER_TAG}..."
                dir('day4-parametrized') {
                    withCredentials([usernamePassword(
                        credentialsId: 'github-pat',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )]) {
                        sh '''
                            git config user.email "jenkins@example.com"
                            git config user.name "Jenkins CI"
                            git tag -a ${DOCKER_TAG} -m "Release ${DOCKER_TAG}"
                            git push https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/amoghkrrish/jenkins-pipeline.git ${DOCKER_TAG}
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning up old Docker images...'
            sh 'docker system prune -af --volumes || true'
        }
    }
}

